class DistanceCalculator:
    def __init__(self, x1=None, y1=None, x2=None, y2=None):
        self.x1 = x1
        self.y1 = y1
        self.x2 = x2
        self.y2 = y2

    def distance(self):
        result = (((self.x2 - self.x1) ** 2 + (self.y2 - self.y1) ** 2) ** 0.5)
        return result

    def slope(self):
        if self.x2 - self.x1 == 0:
            return "undefined (Vertical Line)"
        result = (self.y2 - self.y1) / (self.x2 - self.x1)
        return result

    def get_info(self):
        try:
            x1 = int(input("Enter x1: "))
            y1 = int(input("Enter y1: "))
            x2 = int(input("Enter x2: "))
            y2 = int(input("Enter y2: "))
        except ValueError:
            print("Please enter numbers only")
            return

        self.x1 = x1
        self.y1 = y1
        self.x2 = x2
        self.y2 = y2

    def run(self):
        choice = input("For slope calculation press 1, for distance press 2: ")

        if choice == "1":
            self.get_info()
            result = self.slope()
            print("Calculated slope:", result)

        elif choice == "2":
            self.get_info()
            result = self.distance()
            print("Distance between points:", result)

        else:
            print("Invalid choice")


calc = DistanceCalculator()
calc.run()
