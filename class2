class Bank:
    bank_name = "INVESTMENT WONDER"
    customers = []

    def __init__(self, name, surname, age, balance=0):
        self.name = name
        self.surname = surname
        self.age = age
        self.balance = balance
        Bank.customers.append(self)

    def registered_customers(self):
        print("*" * 20, "REGISTERED CUSTOMERS", "*" * 20)
        if not Bank.customers:
            print("No registered customers yet.")
            return

        for customer in Bank.customers:
            print(f"- {customer.name} {customer.surname}, Age: {customer.age}, Balance: {customer.balance}")

    def sign_up(self):
        name = input("Enter your name: ")
        surname = input("Enter your surname: ")
        age = int(input("Enter your age: "))
        balance = 0

        if age >= 18:
            Bank(name, surname, age, balance)
            return "Membership successfully created"
        else:
            print("Registration failed (age must be 18+)")

    def cancel_membership(self, person, surname):
        for record in Bank.customers:
            if record.name == person and record.surname == surname:
                given_money = record.balance
                print(record.withdraw(given_money))
                Bank.customers.remove(record)
                print(f"""{given_money} can be withdrawn from the ATM
Your membership has been successfully cancelled""")
                return
        print("Operation failed")

    def info_screen(self):
        return f"{self.name} {self.surname} {self.age} {self.balance}"

    def search_member(self, person, surname):
        for record in Bank.customers:
            if record.name == person and record.surname == surname:
                print("Customer found")
                print(record.info_screen())
                return
        print("Customer not found")

    def deposit(self, amount):
        self.balance += amount
        return f"{amount} TL deposited. New balance: {self.balance}"

    def withdraw(self, amount):
        if amount <= self.balance:
            self.balance -= amount
            return f"{amount} TL withdrawn. New balance: {self.balance}"
        else:
            return "Operation failed"
